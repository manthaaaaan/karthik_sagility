{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "catalog": {
      "root": "services/catalog",
      "framework": "fastapi"
    },
    "order": {
      "root": "services/order",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "catalog",
          "format": "url",
          "env": "CATALOG_SERVICE_URL"
        }
      ]
    },
    "payment": {
      "root": "services/payment",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "order",
          "format": "url",
          "env": "ORDER_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/catalog/(.*)",
      "destination": {
        "service": "catalog"
      }
    },
    {
      "source": "/api/orders/(.*)",
      "destination": {
        "service": "order"
      }
    },
    {
      "source": "/api/payments/(.*)",
      "destination": {
        "service": "payment"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
